generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Users {
  id                                                           Int                 @id @default(autoincrement())
  username                                                     String              @db.VarChar(255)
  email                                                        String              @db.VarChar(255)
  password                                                     String              @db.VarChar(255)
  display_name                                                 String              @map("display_name") @db.VarChar(255)
  role_id                                                      Int                 @map("role_id")
  customer_id                                                  Int?                @map("customer_id")
  complain_category                                            Int?                @map("complain_category")
  last_login                                                   DateTime?           @map("last_login") @db.Date
  token                                                        String?             @db.VarChar(255)
  created_at                                                   DateTime            @map("created_at") @db.DateTime(0)
  updated_at                                                   DateTime?           @updatedAt @map("updated_at") @db.DateTime(0)
  created_by                                                   Int                 @map("created_by")
  updated_by                                                   Int?                @map("updated_by")
  trash                                                        Int?
  department                                                   String?             @db.VarChar(255)
  contact_id                                                   Int?                @map("contact_id")
  profile_picture                                              String?             @map("profile_picture") @db.VarChar(255)
  employee_id                                                  Int?                @map("employee_id")
  list_customer                                                String?             @map("list_customer") @db.Text
  list_contact                                                 String?             @map("list_contact") @db.Text
  central_pic_id                                               String?             @map("central_pic_id") @db.VarChar(255)
  setup_password_token                                         String?             @map("setup_password_token") @db.VarChar(255)
  setup_token_expires_at                                       DateTime?           @map("setup_token_expires_at") @db.DateTime(0)
  reset_password_token                                         String?             @map("reset_password_token") @db.VarChar(255)
  reset_token_expires_at                                       DateTime?           @map("reset_token_expires_at") @db.DateTime(0)
  analystRules                                                 AnalystRules[]
  complain                                                     complain[]
  fu_customer                                                  fu_customer[]
  handover                                                     handover[]
  internal_request                                             internal_request[]
  inv_calib                                                    inv_calib[]
  order                                                        Order[]
  po                                                           po[]
  promotion_program                                            promotion_program[]
  purchase                                                     purchase[]
  service_history                                              service_history[]
  role                                                         Roles               @relation(fields: [role_id], references: [id], onUpdate: Restrict, map: "users_ibfk_1")
  customer                                                     Customer?           @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "users_ibfk_2")
  complain_category_users_complain_categoryTocomplain_category complain_category?  @relation("users_complain_categoryTocomplain_category", fields: [complain_category], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "users_ibfk_3")

  @@index([complain_category], map: "complain_category")
  @@index([customer_id], map: "customer_id")
  @@index([role_id], map: "role_id")
  @@map("users")
}

model Roles {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(255)
  users Users[]

  @@map("roles")
}

model Customer {
  id                Int                 @id @default(autoincrement())
  code              String              @db.VarChar(255)
  zahir_id          String?             @map("zahir_id") @db.VarChar(20)
  customer_name     String              @map("customer_name") @db.VarChar(255)
  business          String              @db.VarChar(255)
  npwp              String?             @db.VarChar(255)
  legal_document    String?             @map("legal_document") @db.VarChar(255)
  email             String?             @db.VarChar(255)
  website           String?             @db.VarChar(255)
  bank_name         String?             @map("bank_name") @db.VarChar(255)
  account_name      String?             @map("account_name") @db.VarChar(255)
  account_number    String?             @map("account_number") @db.VarChar(255)
  bank_branch       String?             @map("bank_branch") @db.VarChar(255)
  bank_address      String?             @map("bank_address") @db.VarChar(255)
  supplier_of       String?             @map("supplier_of") @db.VarChar(255)
  supplier_code     String?             @map("supplier_code") @db.VarChar(255)
  remarks           String?             @db.VarChar(255)
  updated_at        DateTime?           @updatedAt @map("updated_at") @db.DateTime(0)
  created_by        Int?                @map("created_by")
  created_at        DateTime            @map("created_at") @db.DateTime(0)
  trash             Int?
  updated_by        Int?                @map("updated_by")
  special_customer  Int?                @map("special_customer")
  top               Int?
  payment_middle    Int?                @map("payment_middle")
  sales_incharge    String?             @map("sales_incharge") @db.VarChar(255)
  ecoa              Int?
  feeder            String?             @db.VarChar(255)
  feeder_fee        Int?                @map("feeder_fee")
  agency            Int?
  sales_feeder      Int?                @map("sales_feeder")
  p_drop            Int?                @default(0) @map("p_drop")
  p_growth          Int?                @default(0) @map("p_growth")
  p_lost            Int?                @default(0) @map("p_lost")
  p_new             Int?                @default(0) @map("p_new")
  p_all             Int?                @default(0) @map("p_all")
  sales_id          Int?                @map("sales_id")
  central_cust_id   String?             @map("central_cust_id") @db.VarChar(255)
  is_corporate      Int?                @default(0) @map("is_corporate")
  active_promo      active_promo[]
  addresses         Address[]
  complain          complain[]
  contacts          Contact[]
  contracts         Contract[]
  fu_customer       fu_customer[]
  inv_calib         inv_calib[]
  invoices          Invoice[]
  list_equipment    list_equipment[]
  orders            Order[]
  preOrders         PreOrder[]
  quotations        Quotation[]
  quotation_enviro  quotation_enviro[]
  sampling_schedule sampling_schedule[]
  standarts         Standart[]
  users             Users[]
  packages          Package[]

  @@index([customer_name], map: "idx_customer_name")
  @@index([special_customer, top], map: "idx_customer_special_top")
  @@map("customer")
}

model AnalystRules {
  id              Int         @id @default(autoincrement())
  user_id         Int         @map("user_id")
  analyst_type_id Int         @map("analyst_type_id")
  created_at      DateTime    @map("created_at") @db.DateTime(0)
  updated_at      DateTime?   @updatedAt @map("updated_at") @db.DateTime(0)
  created_by      Int
  updated_by      Int?
  trash           Int?
  autorize        String?     @db.VarChar(255)
  user            Users       @relation(fields: [user_id], references: [id], onUpdate: Restrict, map: "analyst_rules_ibfk_1")
  analystType     AnalystType @relation(fields: [analyst_type_id], references: [id], onUpdate: Restrict, map: "analyst_rules_ibfk_2")

  @@index([analyst_type_id], map: "analyst_type_id")
  @@index([user_id], map: "user_id")
  @@map("analyst_rules")
}

model AnalystType {
  id           Int            @id @default(autoincrement())
  name         String         @db.VarChar(255)
  list_service String         @map("list_service") @db.LongText
  created_at   DateTime       @map("created_at") @db.DateTime(0)
  updated_at   DateTime?      @updatedAt @map("updated_at") @db.DateTime(0)
  created_by   Int            @map("created_by")
  updated_by   Int?           @map("updated_by")
  trash        Int?
  analystRules AnalystRules[]
  services     Service[]

  @@map("analyst_type")
}

model Contact {
  id                Int                 @id @default(autoincrement())
  customer_id       Int                 @map("customer_id")
  address_id        Int                 @map("address_id")
  title             String              @db.VarChar(255)
  first_name        String              @map("first_name") @db.VarChar(255)
  middle_name       String?             @map("middle_name") @db.VarChar(255)
  surname           String              @db.VarChar(255)
  username          String              @db.VarChar(255)
  job_title         String?             @map("job_title") @db.VarChar(255)
  department        String?             @db.VarChar(255)
  email             String              @db.VarChar(255)
  phone             String              @db.VarChar(255)
  fax               String?             @db.VarChar(255)
  mobile_phone      String?             @map("mobile_phone") @db.VarChar(255)
  created_at        DateTime            @map("created_at") @db.DateTime(0)
  updated_at        DateTime?           @updatedAt @map("updated_at") @db.DateTime(0)
  created_by        Int                 @map("created_by")
  updated_by        Int?                @map("updated_by")
  status            String?             @db.VarChar(45)
  trash             Int?
  onesignal_id      String?             @map("onesignal_id") @db.VarChar(100)
  central_user_id   String?             @map("central_user_id") @db.VarChar(255)
  active_promo      active_promo[]
  customer          Customer            @relation(fields: [customer_id], references: [id], onUpdate: Restrict, map: "contact_ibfk_1")
  address           Address             @relation(fields: [address_id], references: [id], onUpdate: Restrict, map: "contact_ibfk_2")
  inv_calib         inv_calib[]
  invoice           Invoice[]
  orders            Order[]
  preOrders         PreOrder[]
  quotations        Quotation[]
  quotation_enviro  quotation_enviro[]
  sampling_schedule sampling_schedule[]

  @@index([address_id], map: "address_id")
  @@index([customer_id], map: "customer_id")
  @@map("contact")
}

model Address {
  id                 Int                 @id @default(autoincrement())
  customer_id        Int                 @map("customer_id")
  address_type       String              @map("address_type") @db.VarChar(255)
  address            String              @db.Text
  phone              String              @db.VarChar(255)
  fax                String?             @db.VarChar(255)
  city               String              @db.VarChar(255)
  state              String              @db.VarChar(255)
  country            String              @db.VarChar(255)
  postal_code        Int?                @map("postal_code")
  created_at         DateTime            @map("created_at") @db.DateTime(0)
  updated_at         DateTime?           @updatedAt @map("updated_at") @db.DateTime(0)
  created_by         Int                 @map("created_by")
  updated_by         Int?                @map("updated_by")
  status             String?             @db.VarChar(45)
  npwp               String?             @db.VarChar(100)
  trash              Int?
  central_address_id Int?                @map("central_address_id")
  customer           Customer            @relation(fields: [customer_id], references: [id], onUpdate: Restrict, map: "address_ibfk_1")
  contacts           Contact[]
  inv_calib          inv_calib[]
  invoice            Invoice[]
  orders             Order[]
  quotations         Quotation[]
  quotation_enviro   quotation_enviro[]
  sampling_schedule  sampling_schedule[]

  @@index([customer_id], map: "customer_id")
  @@map("address")
}

model Matrix {
  id      Int      @id @default(autoincrement())
  name    String   @db.VarChar(255)
  trash   Int?
  methods Method[]

  @@map("matrix")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  trash     Int?
  services  Service[]
  standarts Standart[]

  @@map("category")
}

model Method {
  id              Int       @id @default(autoincrement())
  code            String    @db.VarChar(255)
  name            String    @db.VarChar(255)
  matrix_id       Int?      @default(0) @map("matrix_id")
  category_name   String    @map("category_name") @db.VarChar(255)
  status          String?   @db.VarChar(255)
  description     String?   @db.Text
  method_document String?   @map("method_document") @db.VarChar(255)
  instruction     String?   @db.Text
  created_at      DateTime  @map("created_at") @db.DateTime(0)
  updated_at      DateTime? @updatedAt @map("updated_at") @db.DateTime(0)
  created_by      Int?      @map("created_by")
  updated_by      Int?      @map("updated_by")
  trash           Int?
  delete_reason   String?   @db.VarChar(200)
  matrix          Matrix?   @relation(fields: [matrix_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "method_ibfk_1")
  services        Service[]

  @@index([matrix_id], map: "matrix_id")
  @@map("method")
}

model Lab {
  id         Int         @id @default(autoincrement())
  name       String      @db.VarChar(255)
  trash      Int?
  created_at DateTime?   @db.DateTime(0)
  parameters Parameter[]
  units      Unit[]
  unit_lab   unit_lab[]

  @@map("lab")
}

model Parameter {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  lab_id         Int              @map("lab_id")
  trash          Int?
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  lab            Lab              @relation(fields: [lab_id], references: [id], onUpdate: Restrict, map: "parameter_ibfk_1")
  parameter_unit parameter_unit[]
  services       Service[]

  @@index([lab_id], map: "lab_id")
  @@map("parameter")
}

model Unit {
  id             Int              @id @default(autoincrement())
  name           String           @db.VarChar(255)
  lab_id         Int?             @map("lab_id")
  description    String?          @db.Text
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  parameter_unit parameter_unit[]
  lab            Lab?             @relation(fields: [lab_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "unit_ibfk_1")
  unit_lab       unit_lab[]

  @@index([lab_id], map: "lab_id")
  @@map("unit")
}

model Subcontractor {
  id           Int           @id @default(autoincrement())
  lab_name     String        @map("lab_name") @db.VarChar(255)
  address_name String        @map("address_name") @db.VarChar(255)
  phone        String        @db.VarChar(255)
  fax          String        @db.VarChar(255)
  contact      String        @db.VarChar(255)
  email        String        @db.VarChar(255)
  trash        Int?
  services     Service[]
  service_cal  service_cal[]

  @@map("subcontractor")
}

model Service {
  id                       Int               @id @default(autoincrement())
  code                     String            @db.VarChar(255)
  name                     String            @db.VarChar(255)
  category_id              Int               @map("category_id")
  parameter_id             Int               @map("parameter_id")
  method_id                Int               @map("method_id")
  accreditation            String?           @db.VarChar(255)
  accreditation_valid_date String?           @map("accreditation_valid_date") @db.VarChar(255)
  unit                     String?           @db.VarChar(255)
  published_date           String?           @map("published_date") @db.VarChar(255)
  lod                      String?           @db.VarChar(255)
  loq                      String?           @db.VarChar(255)
  proficiency_test         String?           @map("proficiency_test") @db.VarChar(255)
  description              String?           @db.Text
  price                    Int
  priority_setting         Int?
  status                   String?           @db.VarChar(255)
  subcontractor_id         Int?              @map("subcontractor_id")
  use_pc                   Int?              @map("use_pc")
  created_by               Int               @map("created_by")
  created_at               DateTime          @map("created_at") @db.DateTime(0)
  updated_by               Int?              @map("updated_by")
  updated_at               DateTime?         @updatedAt @map("updated_at") @db.DateTime(0)
  trash                    Int?
  delete_reason            String?           @db.VarChar(100)
  analyst_type_id          Int?              @map("analyst_type_id")
  user                     Int
  version                  String?           @db.VarChar(20)
  category                 Category          @relation(fields: [category_id], references: [id], onUpdate: Restrict, map: "service_ibfk_1")
  parameter                Parameter         @relation(fields: [parameter_id], references: [id], onUpdate: Restrict, map: "service_ibfk_2")
  method                   Method            @relation(fields: [method_id], references: [id], onUpdate: Restrict, map: "service_ibfk_3")
  subcontractor            Subcontractor?    @relation(fields: [subcontractor_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "service_ibfk_4")
  analystType              AnalystType?      @relation(fields: [analyst_type_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contractDetails          ContractDetail[]
  service_history          service_history[]
  worksheets               Worksheet[]
  standartDetails          StandartDetail[]
  quotation_details        quotation_detail[]

  @@index([category_id], map: "category_id")
  @@index([method_id], map: "method_id")
  @@index([parameter_id], map: "parameter_id")
  @@index([analyst_type_id], map: "service_analyst_type_id_index")
  @@index([subcontractor_id], map: "subcontractor_id")
  @@map("service")
}

model Standart {
  id              Int              @id @default(autoincrement())
  code            String           @db.VarChar(255)
  name            String           @db.VarChar(255)
  category_id     Int?             @map("category_id")
  customer_id     Int?             @map("customer_id")
  created_at      DateTime         @map("created_at") @db.DateTime(0)
  updated_at      DateTime?        @updatedAt @map("updated_at") @db.DateTime(0)
  created_by      Int              @map("created_by")
  updated_by      Int?             @map("updated_by")
  trash           Int?
  pre_sample      pre_sample[]
  samples         Sample[]
  category        Category?        @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "standart_ibfk_1")
  customer        Customer?        @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "standart_ibfk_2")
  standartDetails StandartDetail[]
  worksheets      Worksheet[]

  @@index([category_id], map: "category_id")
  @@index([customer_id], map: "customer_id")
  @@map("standart")
}

model StandartDetail {
  id          Int      @id @default(autoincrement())
  standart_id Int      @map("standart_id")
  service_id  Int      @map("service_id")
  max         String   @db.VarChar(255)
  min         String   @db.VarChar(255)
  unit        String   @db.VarChar(255)
  standart    Standart @relation(fields: [standart_id], references: [id], onUpdate: Restrict, map: "standart_detail_ibfk_1")
  service     Service  @relation(fields: [service_id], references: [id], onUpdate: Restrict, map: "standart_detail_ibfk_2")

  @@index([service_id], map: "service_id")
  @@index([standart_id], map: "standart_id")
  @@map("standart_detail")
}

model Quotation {
  id                Int                 @id @default(autoincrement())
  code              String              @db.VarChar(255)
  quo_status        String              @map("quo_status") @db.VarChar(255)
  quo_date          DateTime            @map("quo_date") @db.Date
  sampling_request  String?             @map("sampling_request") @db.VarChar(255)
  sampling_date     DateTime?           @map("sampling_date") @db.Date
  customer_id       Int?                @map("customer_id")
  contact_id        Int?                @map("contact_id")
  address_id        Int?                @map("address_id")
  volume            String?             @db.VarChar(255)
  remarks           String?             @db.VarChar(255)
  min_volume_sample String?             @map("min_volume_sample") @db.VarChar(255)
  sub_total         Float               @map("sub_total") @db.Float
  percent_discount  Float               @default(0) @map("percent_discount") @db.Float
  percent_vat       Float               @default(11) @map("percent_vat") @db.Float
  percent_pc        Float?              @map("percent_pc")
  price_group       Int?                @map("price_group")
  priority          String?             @db.VarChar(255)
  total             Float               @db.Float
  created_at        DateTime            @map("created_at") @db.DateTime(0)
  updated_at        DateTime?           @updatedAt @map("updated_at") @db.DateTime(0)
  created_by        Int                 @map("created_by")
  updated_by        Int?                @map("updated_by")
  expired_date      DateTime?           @map("expired_date") @db.Date
  lab               String?             @db.VarChar(255)
  trash             Int?
  orders            Order[]
  customer          Customer?           @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "quotation_ibfk_1")
  contact           Contact?            @relation(fields: [contact_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "quotation_ibfk_2")
  address           Address?            @relation(fields: [address_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "quotation_ibfk_3")
  quotation_detail  quotation_detail[]
  sampling_schedule sampling_schedule[]

  @@index([address_id], map: "address_id")
  @@index([contact_id], map: "contact_id")
  @@index([customer_id], map: "customer_id")
  @@map("quotation")
}

model PreOrder {
  id                 Int          @id @default(autoincrement())
  code               String       @db.VarChar(255)
  customer_id        Int          @map("customer_id")
  quotation_id       Int?         @map("quotation_id")
  contact_id         Int          @map("contact_id")
  received_date      DateTime?    @map("received_date") @db.Date
  delivery           String?      @db.VarChar(255)
  receipt_number     String?      @map("receipt_number") @db.VarChar(255)
  driver_id          Int?         @map("driver_id")
  order_id           Int?         @map("order_id")
  submited_by        String       @map("submited_by") @db.VarChar(255)
  sample_quantity    Int          @default(1) @map("sample_quantity")
  priority           String?      @db.VarChar(255)
  document           String?      @db.VarChar(255)
  covering_letter    String?      @map("covering_letter") @db.VarChar(255)
  testing_parameters String?      @map("testing_parameters") @db.VarChar(255)
  complete_date      DateTime?    @map("complete_date") @db.DateTime(0)
  created_at         DateTime?    @map("created_at") @db.DateTime(0)
  updated_at         DateTime?    @map("updated_at") @db.DateTime(0)
  created_by         Int?         @map("created_by")
  updated_by         Int?         @map("updated_by")
  trash              Int?
  remarks            String?      @db.VarChar(255)
  unlock             Int?
  characteristic     Int?
  lab                Int
  subcon             Int?
  subcon_id          Int?         @map("subcon_id")
  subcon_due         DateTime?    @map("subcon_due") @db.Date
  notes_customer     String?      @map("notes_customer") @db.VarChar(255)
  orders             Order[]
  customer           Customer     @relation(fields: [customer_id], references: [id], onUpdate: Restrict, map: "pre_order_ibfk_1")
  contact            Contact      @relation(fields: [contact_id], references: [id], onUpdate: Restrict, map: "pre_order_ibfk_2")
  driver             driver?      @relation(fields: [driver_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "pre_order_ibfk_4")
  pre_sample         pre_sample[]

  @@index([contact_id], map: "contact_id")
  @@index([customer_id], map: "customer_id")
  @@index([driver_id], map: "driver_id")
  @@index([order_id], map: "order_id")
  @@index([quotation_id], map: "quotation_id")
  @@map("pre_order")
}

model Contract {
  id                 Int              @id @default(autoincrement())
  code               String           @db.VarChar(255)
  customerId         Int              @map("customer_id")
  period             String           @db.VarChar(255)
  periodFrom         DateTime         @map("periode_from") @db.Date
  periodTo           DateTime         @map("periode_to") @db.Date
  periodAlias        String?          @map("period_alias") @db.VarChar(255)
  documents          String?          @map("contract_document") @db.VarChar(255)
  normalDay          Int              @default(10) @map("normal_day")
  urgentDay          Int              @default(7) @map("urgent_day")
  veryUrgentDay      Int              @default(5) @map("very_urgent_day")
  statusService      String?          @map("status_service") @db.VarChar(255)
  remarks            String?          @db.VarChar(255)
  discount           Float            @default(0) @db.Float
  discountUrgent     Int              @default(50) @map("dsc_urgent")
  discountVeryUrgent Int              @default(100) @map("dsc_very_urgent")
  createdAt          DateTime         @map("created_at") @db.DateTime(0)
  updatedAt          DateTime?        @updatedAt @map("updated_at") @db.DateTime(0)
  createdBy          Int              @map("created_by")
  updatedBy          Int?             @map("updated_by")
  trash              Int?
  promotionId        Int?             @map("promotion_id")
  customer           Customer         @relation(fields: [customerId], references: [id], onUpdate: Restrict, map: "contract_ibfk_1")
  details            ContractDetail[]

