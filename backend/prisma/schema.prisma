  created_at         DateTime?            @db.DateTime(0)
  updated_at         DateTime?            @db.DateTime(0)
  created_by         Int?
  updated_by         Int?
  trash              Int?
  email              String?              @db.VarChar(255)
  top                Int
  fin_payable        fin_payable[]
  procurement_detail procurement_detail[]
}

model system {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(150)
  created_by    Int
  trash         Int?
  delete_reason String? @db.VarChar(225)
}

model type_cal {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  trash       Int?
  method_cal  method_cal[]
  service_cal service_cal[]
}

model unit_lab {
  id      Int  @id @default(autoincrement())
  unit_id Int
  lab_id  Int
  lab     Lab  @relation(fields: [lab_id], references: [id], onUpdate: Restrict, map: "unit_lab_lab_id_foreign")
  unit    Unit @relation(fields: [unit_id], references: [id], onUpdate: Restrict, map: "unit_lab_unit_id_foreign")

  @@index([lab_id], map: "unit_lab_lab_id_foreign")
  @@index([unit_id], map: "unit_lab_unit_id_foreign")
}

model vehicle {
  id            Int    @id @default(autoincrement())
  police_number String @db.VarChar(255)
  vehicle_type  String @db.VarChar(255)
  trash         Int?
}

model webhook_zahir_logs {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  data       String?   @db.LongText
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
}

enum sampling_plan_cc_plan_type {
  actual
  plan
}

enum pickup_pickup_status {
  CREATED
  ASSIGNED
  RECEIVED
  COMPLETED
}
